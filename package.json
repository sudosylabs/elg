{
  "name": "@vnilint/elg",
  "version": "0.1.0-dev.0",
  "description": "Owned native macOS Liquid Glass attachments for Electron windows",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "prebuilds/**/*.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:native": "node-gyp rebuild --devdir=.cache/node-gyp",
    "build:prebuilds": "node scripts/build-prebuilds.mjs",
    "build:all": "npm run build:native && npm run build",
    "clean": "rimraf build prebuilds dist dist-examples",
    "check": "tsc --noEmit --project tsconfig.build.json",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:native": "npm run build:all && node test/run-electron.mjs",
    "example": "npm run build:all && tsc --project tsconfig.examples.json && electron dist-examples/electron.js",
    "prepack": "npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:package": "node test/package.mjs",
    "prepublishOnly": "npm run check:release && npm run check && npm test && npm run check:package"
  },
  "keywords": [
    "electron",
    "macos",
    "liquid-glass",
    "nsglasseffectview"
  ],
  "gypfile": false,
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@types/node": "^22",
    "electron": "44.8.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.1",
    "typescript": "^5"
  },
  "packageManager": "npm@11.6.2",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/sudosylabs/elg.git"
  },
  "homepage": "https://github.com/sudosylabs/elg#readme",
  "bugs": {
    "url": "https://github.com/sudosylabs/elg/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
